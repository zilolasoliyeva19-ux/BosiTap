# Keep real secrets in your hosting provider's Environment Variables / Secrets panel.
# Never commit a real Telegram bot token to GitHub.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Public HTTPS URL of the deployed app, without a trailing slash.
# Google AI Studio may inject APP_URL automatically; set it manually on other hosts.
APP_URL="https://your-deployed-app.example"

# Create a bot with @BotFather. Store the real token only in server-side secrets.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
# Bot username without @, e.g. BosiTapBot
TELEGRAM_BOT_USERNAME="BosiTapBot"

# Required for webhook authentication. Generate a long random string using only A-Z, a-z, 0-9, _ and -.
# Do not reuse the bot token as this secret.
TELEGRAM_WEBHOOK_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
